# Nome do workflow
name: Deployment Jekyll with GitHub Pages

# Quando o workflow será acionado:
on:
  # Quando houver push para o branch "main"
  push:
    branches: ["main"]
    # Somente quando qualquer arquivo for alterado
    paths:
      - '**/*'
  # Permite acionamento manual pela interface do GitHub
  workflow_dispatch:
  # Executa automaticamente a cada 2 dias (à meia-noite)
  schedule:
    - cron: '0 0 */2 * *'

# Permissões necessárias:
permissions:
  contents: write  # Permite escrever no repositório
  pages: write     # Permite publicar no GitHub Pages
  id-token: write  # Para autenticação

# Controle de concorrência para evitar execuções paralelas:
concurrency:
  group: "pages"   # Agrupa todas as execuções relacionadas a pages
  cancel-in-progress: false  # Não cancela execuções em andamento

# Definição dos jobs:
jobs:
  # Primeiro job: Configuração e preparação dos arquivos
  setup:
    runs-on: ubuntu-latest  # Executa no Ubuntu mais recente
    steps:
      # Baixa o código do repositório
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Baixa todo o histórico do git

      # Configura o ambiente Node.js (versão 20)
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      # Instala as dependências do Node.js
      - name: Install dependencies
        run: npm install

      # Executa um script para gerar metadados dos arquivos
      - name: Generate files metadata
        run: npm start
        env:
          GITHUB_TOKEN: ${{ secrets.MY_PAGES_GITHUB_TOKEN }}

      # Faz commit do arquivo de metadados gerado
      - name: Commit metadata changes
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add files_metadata.json
          git diff --cached --quiet || git commit -m "Automatic metadata update [skip ci]"
          git push

  # Segundo job: Construção do site Jekyll
  build:
    needs: setup  # Depende do job setup terminar primeiro
    runs-on: ubuntu-latest
    steps:
      # Baixa o repositório novamente (agora com os metadados atualizados)
      - name: Checkout repository
        uses: actions/checkout@v4

      # Configura o ambiente Ruby (versão 3.1) com cache do Bundler
      - name: Setup Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: '3.1'
          bundler-cache: true

      # Configura as definições do GitHub Pages
      - name: Setup Pages
        uses: actions/configure-pages@v5

      # Constrói o site Jekyll da pasta origem para a pasta destino
      - name: Build with Jekyll
        uses: actions/jekyll-build-pages@v1
        with:
          source: ./
          destination: ./_site

      # Faz upload do site construído como artefato para deploy
      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: './_site'

  # Terceiro job: Publicação no GitHub Pages
  deploy:
    # Configurações de ambiente (aparece no histórico de deploys do GitHub)
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build  # Depende do job build terminar primeiro
    steps:
      # Verifica se há deploys ativos para evitar conflitos
      - name: Check active deployments
        id: check-deploy
        run: |
          echo "Verificando deploys ativos..."
          
          # Tenta verificar por 10 minutos (60 tentativas com intervalo de 10s)
          for i in {1..60}; do
            # Usa a API do GitHub para verificar o status do Pages
            RESPONSE=$(curl -s -H "Authorization: token ${{ secrets.GITHUB_TOKEN }}" \
              -H "Accept: application/vnd.github.v3+json" \
              "https://api.github.com/repos/${{ github.repository }}/pages")
            
            # Extrai o status do deploy mais recente
            DEPLOY_STATUS=$(echo "$RESPONSE" | jq -r '.status')
            
            if [[ "$DEPLOY_STATUS" == "built" || "$DEPLOY_STATUS" == "null" ]]; then
              echo "Nenhum deploy ativo encontrado. Prosseguindo..."
              echo "ready=true" >> $GITHUB_OUTPUT
              break
            else
              echo "Deploy em andamento encontrado (status: $DEPLOY_STATUS). Tentativa $i/60..."
              if [ $i -eq 60 ]; then
                echo "Timeout atingido. Falha ao aguardar deploy anterior."
                exit 1
              fi
              sleep 10
            fi
          done

      # Publica o site no GitHub Pages
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
        with:
          timeout: 600000  # Timeout de 10 minutos
          token: ${{ secrets.GITHUB_TOKEN }}  # Token de autenticação
